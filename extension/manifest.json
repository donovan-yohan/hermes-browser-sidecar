{
  "manifest_version": 3,
  "name": "Hermes Browser Sidecar",
  "version": "0.2.0",
  "description": "Side panel client for the local Hermes browser sidecar service.",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Hermes Browser Sidecar"
  }
}
